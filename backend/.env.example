# Optional. With an LLM configured, the app reads each video's title and
# description to fill in anime / type / number / song / artist. Without one,
# you type the tags yourself (the search box still parses things like
# "frieren ed 2").
#
# Any OpenAI-compatible /chat/completions endpoint works - Anthropic, a local
# Ollama, DeepSeek, OpenRouter - by changing just these three values. Copy this
# file to ".env" and uncomment one block.

# --- Anthropic (pay-per-use API, separate from a Claude.ai subscription) ---
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-4-5

# --- Local Ollama (free, needs Ollama running with a model pulled) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
