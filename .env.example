# Optional: enables AI-based parsing of YouTube titles into
# anime/type/number/song/artist on the Search tab. Without this,
# the app falls back to rule-based guessing only.
#
# Works with any OpenAI-compatible "chat completions" API, so you can
# point it at Anthropic, a local Ollama, Kimi/Moonshot, DeepSeek,
# OpenRouter, etc. by only changing these three values - no code changes
# needed. Copy this file to ".env" and uncomment the option you want.

# --- Anthropic (pay-per-use API, separate from a Claude.ai subscription) ---
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-4-5

# --- Local Ollama (free, needs Ollama running with a model pulled) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
